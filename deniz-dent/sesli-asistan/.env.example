# ------------------------------------------------------------------
# Deniz Dent Sesli Asistan - ortam degiskenleri
# Bu dosyayi .env olarak kopyalayin ve doldurun. .env ASLA commit edilmez.
# ------------------------------------------------------------------

# --- DEMO MODU ---
# true  -> Postgres/Twilio/panel parolasi GEREKMEZ, veriler bellekte tutulur,
#          http://localhost:PORT adresinde sunum ekrani acilir.
# false -> gercek kurulum.
DEMO_MOD=false

# --- Sunucu ---
PORT=3000
# Twilio'nun bize ulasacagi genel adres (imza dogrulamasi icin sart).
# Ornek: https://deniz-dent.up.railway.app
GENEL_ADRES=

# --- Veritabani (PostgreSQL) ---
# Railway / Supabase tek satirlik baglanti dizesi verir.
DATABASE_URL=postgres://kullanici:parola@localhost:5432/denizdent
# Yonetilen saglayicilarda genelde true, yerelde false.
DB_SSL=false

# --- Anthropic (Claude) ---
# NOT: degisken adlari ASISTAN_ onekli. CLAUDE_* adlari bazi ortamlarda
# (ornegin Claude Code konteynerlerinde) baska amacla tanimli oluyor ve
# uygulamanin ayarini sessizce eziyordu.
ANTHROPIC_API_KEY=
# Varsayilan model. Telefonda gecikme yuksek gelirse claude-haiku-4-5 deneyin.
ASISTAN_MODEL=claude-opus-5-5
# low | medium | high  -> seslide low onerilir (gecikme dusuk kalir)
ASISTAN_EFFORT=low
ASISTAN_MAX_TOKENS=800

# --- Twilio ---
TWILIO_AUTH_TOKEN=
# Konusma dili. Test edilmeden degistirmeyin (bkz. README > Turkce dogrulama).
SES_DILI=tr-TR
TTS_SAGLAYICI=ElevenLabs
# Bos birakilirsa Twilio dile gore varsayilan sesi secer.
TTS_SES=

# --- ElevenLabs (ses) ---
# Demo ekrani bu anahtarla konusur. Bos birakilirsa demo calisir ama ses cikmaz.
ELEVENLABS_API_KEY=
# Varsayilan: "Sevval - Call Center" - sesli asistanlar icin hazirlanmis Turkce ses.
# DIKKAT: Bu ses ElevenLabs kutuphanesinden geliyor. Ucretsiz hesaplar
# kutuphane/profesyonel sesleri API uzerinden kullanamaz - HTTP 402 doner.
# Ucretsiz planda ses duymak icin asagidaki satiri yorumdan cikarip
# ustteki satiri yoruma alin ("Sarah", premade ses; Turkce'yi hafif
# aksanla okur, musteri sunumu icin degil ama sistem sinamasi icin yeterli):
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_ID=fnJjHAY6lhrGd5hWLRyU
# flash_v2_5 Turkce destekliyor ve en dusuk gecikmeli model (~75ms).
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_FORMAT=mp3_22050_32

# --- Klinik ---
# Bos birakin: demo modunda config/klinik.demo.json, gercek kurulumda
# config/klinik.json otomatik secilir. Sadece baska bir dosya kullanacaksaniz yazin.
#KLINIK_CONFIG=config/klinik.json
# Asistan cozemedigi/acil durumda bu numaraya aktarir (E.164).
NOBETCI_NUMARA=
# Mesai icinde devir icin resepsiyon numarasi (E.164). Bos ise nobetci kullanilir.
RESEPSIYON_NUMARA=

# --- Panel (sabah teslim ekrani) ---
PANEL_KULLANICI=klinik
# bcrypt hash. Uretmek icin: npm run hash -- 'parolaniz'
PANEL_PAROLA_HASH=
# Oturum suresi (saat)
PANEL_OTURUM_SAAT=12

# Hasta token'i uretiminde kullanilan tuz. Uretimde ZORUNLU ve gizli.
# Rastgele uretin:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Degistirirseniz eski hasta token'lari yeni uretilenlerle eslesmez.
TOKEN_TUZU=

# Bu kurulumun ait oldugu klinik (kiraci) kimligi. Uretimde ZORUNLU.
# Veritabanindaki her satir bu kimlige baglanir; RLS bununla filtreler.
# Yanlis deger = klinik verilerinin birbirine karismasi.
KIRACI_ID=

# --- SMS (KVKK aydinlatma metni gonderimi) ---
# Bos birakilirsa SMS ozelligi KAPALI olur: asistan "SMS gonderebilirim"
# demez ve arac listesinde bu arac bulunmaz. Tutamayacagi sozu vermez.
# Twilio SMS icin TWILIO_ACCOUNT_SID ve TWILIO_AUTH_TOKEN da gerekir.
SMS_GONDEREN_NO=
TWILIO_ACCOUNT_SID=
