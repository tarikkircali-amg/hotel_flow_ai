# MİZ Marketing OS — örnek ayarlar. Gerçek değerleri ortam değişkeni olarak tanımlayın; repoya koymayın.
PORT=4000
MOS_ADMIN_USER=admin
# Boş bırakılırsa ilk açılışta rastgele üretilip konsola bir kez yazılır
MOS_ADMIN_PASSWORD=
MOS_ORG_NAME=My İnovatif Zeka
# Boşsa Demo modu (şablon çıktı)
ANTHROPIC_API_KEY=
MOS_MODEL=claude-opus-5
# low | medium | high
MOS_EFFORT=medium
MOS_MAX_TOKENS=8000
MOS_DEMO_DELAY_MS=2500
# HTTPS arkasında 1 yapın
MOS_COOKIE_SECURE=0
MOS_DB_FILE=./data/marketing-os.db
# Yayın köprüsü (isteğe bağlı): Zapier/Make/n8n "Catch Hook" adresi
MOS_PUBLISH_WEBHOOK_URL=
# Doluysa her gönderim X-MOS-Signature: sha256=<HMAC> başlığıyla imzalanır
MOS_PUBLISH_SECRET=
MOS_PUBLISH_TIMEOUT_MS=15000
# Hostinger / vekil arkasında gerçek IP için 1
MOS_TRUST_PROXY=
# AI görsel (isteğe bağlı): openai | fal
MOS_IMAGE_PROVIDER=
OPENAI_API_KEY=
FAL_KEY=
# Boşsa: openai → gpt-image-1, fal → fal-ai/flux/schnell
MOS_IMAGE_MODEL=
# Performans panosu para birimi (ISO 4217)
MOS_CURRENCY=TRY
# Ofiste karakterin evrakı yürüyerek teslim etmesi için adım arası bekleme (ms). 0 = beklemesiz
MOS_HANDOFF_MS=3800
